# =============================================================================
# Secrets / env
# =============================================================================
.env
.env.*
*.env
!.env.example
!*.env.example
CONFIGS/bot.env
CONFIGS/*.local.json

# =============================================================================
# Heavy data and experiment outputs (NEVER commit)
# =============================================================================
DATA/
data/
RUNS/
runs/
runs_*/
# Local backups / duplicated scene folders (e.g. "DATA (Copy)")
*(Copy)*/
* copy/
output/
outputs/
out/
checkpoints/
ckpts/
wandb/
mlruns/
tb_logs/
tensorboard/
lightning_logs/

# Project-specific experiment dumps
depth_comparison/
servo_mesh/
servo_gs/
kitchen-instant-ngp-tcnn/

# COLMAP / SfM artifacts (regenerate from scans)
**/sparse/
**/dense/
**/database.db
**/database.db-journal
**/colmap_output/

# 3DGS / NeRF generated assets
**/point_cloud/
**/point_cloud.ply
**/*.ply
**/depths_moge/
**/depth_params.json

