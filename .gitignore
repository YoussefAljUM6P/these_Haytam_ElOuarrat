*.npz

# Keep small repo images (logos, doc figures) — re-allow on demand:
# !docs/**/*.png

# =============================================================================
# Autogenerated CLI run snapshots (timestamped name)
# =============================================================================
CONFIGS/cli_*_[0-9][0-9][0-9][0-9][0-9][0-9][0-9][0-9]-[0-9][0-9][0-9][0-9][0-9][0-9].json

# =============================================================================
# Scratch / one-off rewrites at repo root
# =============================================================================
/rewrite_*.py
/type_feature.py
/scratch/
/tmp/
/_tmp/

# =============================================================================
# Python
# =============================================================================
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
build/
dist/
*.egg-info/
